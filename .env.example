# Copiare in .env e impostare una password casuale lunga (almeno 20 caratteri).
FRIDGEBRAIN_UTENTE=fridgebrain
FRIDGEBRAIN_PASSWORD=
# Dominio pubblico con DNS diretto al VPS; Caddy gestisce certificati e rinnovi.
FRIDGEBRAIN_DOMINIO=cucina.example.org
# Percorso per esecuzione Node diretta; Docker usa sempre ./data/personali.
FRIDGEBRAIN_DATI=data
FRIDGEBRAIN_UID=1000
FRIDGEBRAIN_GID=1000
# Identificare l'installazione con un contatto reale. Nessuna chiave API richiesta.
FRIDGEBRAIN_OFF_USER_AGENT="FridgeBrain/1.0 (https://cucina.example.org; contatto: amministratore@example.org)"
# Lasciare il servizio ufficiale in produzione; i test usano HTTP locale simulato.
FRIDGEBRAIN_OFF_URL=https://world.openfoodfacts.org
# Origini aggiuntive per esecuzione diretta; Docker autorizza il dominio HTTPS.
FRIDGEBRAIN_ORIGINI=http://localhost:3000,http://127.0.0.1:3000
# disabilitato, locale; simulato esclusivamente per sviluppo e test.
FRIDGEBRAIN_GENERATORE=disabilitato
FRIDGEBRAIN_OLLAMA_URL=http://127.0.0.1:11434
FRIDGEBRAIN_OLLAMA_DOCKER_URL=http://host.docker.internal:11434
FRIDGEBRAIN_MODELLO=qwen3:8b
NEXT_TELEMETRY_DISABLED=1
