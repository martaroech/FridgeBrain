# Percorsi locali; i dati personali restano separati dal catalogo.
FRIDGEBRAIN_DATI=data
FRIDGEBRAIN_CATALOGO=data/processed/foods.db
# disabilitato, locale; simulato esclusivamente per sviluppo e test.
FRIDGEBRAIN_GENERATORE=disabilitato
FRIDGEBRAIN_OLLAMA_URL=http://127.0.0.1:11434
FRIDGEBRAIN_MODELLO=qwen3:8b
NEXT_TELEMETRY_DISABLED=1

# Docker: pubblicazione soltanto sulla macchina locale per impostazione iniziale.
FRIDGEBRAIN_INDIRIZZO=127.0.0.1
FRIDGEBRAIN_PORTA=3000
# Su Linux usare UID/GID dell'utente proprietario delle directory data/personali e data/processed.
FRIDGEBRAIN_UID=1000
FRIDGEBRAIN_GID=1000
FRIDGEBRAIN_OLLAMA_DOCKER_URL=http://host.docker.internal:11434
# Aggiungere l'origine HTTPS della rete domestica quando si usa un reverse proxy locale.
FRIDGEBRAIN_ORIGINI=http://localhost:3000,http://127.0.0.1:3000
# Profilo HTTPS facoltativo; per il telefono usare l'IP privato del computer in entrambi i campi.
FRIDGEBRAIN_DOMINIO_HTTPS=localhost
FRIDGEBRAIN_HTTPS_INDIRIZZO=127.0.0.1
FRIDGEBRAIN_HTTPS_PORTA=8443
